.env
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
# Your corpus is your data. Files uploaded through the UI land in
# data/tickets/ and must not be committed by accident; .gitkeep keeps the
# folder itself in the repo so the uploader always has somewhere to write.
data/tickets/*
!data/tickets/.gitkeep
data/store/
data/traces/
*.npz
.DS_Store
# Build output from `pip install -e .`
*.egg-info/
build/
dist/
data/gold.yaml

# Eval snapshots embed your questions and your corpus numbers.
data/eval/
data/agent_tasks.yaml
data/agent_memory/

# data/redteam/ is deliberately NOT ignored: the attack corpus is a committed
# artifact, because an exercise nobody else can reproduce proves nothing.
# Its derived index (data/store/redteam/) and its run numbers are not.
data/redteam/eval/
